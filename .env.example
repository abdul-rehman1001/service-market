# Database
DATABASE_URL="postgresql://user:password@localhost:5432/service_market?schema=public"
DATABASE_URL_LOCAL="postgresql://user:password@localhost:5432/service_market?schema=public"
DATABASE_URL_PRODUCTION="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
APP_ENV="local"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"
JWT_SECRET="replace-with-a-long-random-secret"

# Firebase (Web)
NEXT_PUBLIC_FIREBASE_API_KEY="replace-me"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-me"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-me"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="replace-me"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="replace-me"

# Firebase (Admin)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----\n"

# Email (SMTP)
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@example.com"
SMTP_PASS="app-password-or-smtp-password"

# App/public URLs and client config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-public-token"

# Cloudinary server config
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Server-side geocoding token
MAPBOX_TOKEN="your-mapbox-token"

# Optional environment mode
NODE_ENV="development"

# Optional
HUGGINGFACEHUB_API_TOKEN="replace-me"
